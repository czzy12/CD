{
  "name": "中国民生银行",
  "description": "民生银行个人账户对账单",
  "detection_keywords": ["中国民生银行", "民生银行", "CMBC", "民生"],
  "date_format_group": "slash",
  "amount_mode": "sign",
  "amount_rules": {
    "positive_is": "收入",
    "negative_is": "支出",
    "direction_mapping": {
      "进": "收入", "出": "支出",
      "借": "支出", "贷": "收入"
    }
  },
  "skip_keywords": ["合计", "小计", "凭证种类", "凭证号"],
  "header_markers": ["交易时间", "交易金额"],
  "text_line_regex": "(?P<date>\\d{4}/\\d{2}/\\d{2})\\s+(?P<time>\\d{2}:\\d{2}:\\d{2})\\s+(?P<type>.+)\\s+(?P<amount>[+-]?[\\d,]+\\.\\d{2})\\s+[\\d,]+\\.\\d{2}\\s+(?P<counterparty>.*)"
}
