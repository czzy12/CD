{
  "name": "中国工商银行",
  "description": "工商银行借记卡账户历史明细（电子版）",
  "detection_keywords": ["中国工商银行", "工商银行", "ICBC", "工行"],
  "date_format_group": "datetime",
  "column_detection": {
    "strategy": "header_based"
  },
  "amount_mode": "sign",
  "amount_rules": {
    "positive_is": "收入",
    "negative_is": "支出",
    "direction_mapping": {
      "进": "收入",
      "出": "支出",
      "借": "支出",
      "贷": "收入"
    }
  },
  "skip_keywords": ["合计", "小计", "交易日期"],
  "header_markers": ["交易日期", "Transaction"]
}
